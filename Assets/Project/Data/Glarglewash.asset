  m_Script: {fileID: 11500000, guid: 952376c009834cbe9f4e93d41000dbdb, type: 3}
  m_Name: Glarglewash
  m_EditorClassIdentifier: 
  _description: '<b>Recommended Level</b>: 6-8


    <b>Description:</b> The humid
    jungle surrounding the now-half-collapsed <style="link"><link="Yalsanat">Mt.
    Yalsanat</link></style> volcano is a testament to the exuberance of nature, and
    its power to bounce back from disaster greater than ever before. Following the
    <style="link"><link="Yalsanat Eruption">eruption</link></style>, life has sprung
    into every nook and cranny of this mountain, making it a dangerous but rewarding
    adventure to explore. In addition to a number of useful chemicals and herbs,
    miners will want to seek out these slopes for the rare and valuable ores that
    can be found.


    <b>Enemies</b>: <style="link"><link="Kobald">Kobald</link></style>,
    <style="link"><link="Steam Elemental">Steam Elemental</link></style>, <style="link"><link="Jarl
    Gekko">Jarl Gekko</link></style>, <style="link"><link="Drop Bear">Drop Bear</link></style>,
    <style="link"><link="Yellow-Paw Monkey">Yellow-Paw Monkey</link></style>, <style="link"><link="Bird
    of the Sun">Bird of the Sun</link></style>

    <b>Herbs</b>:  <style="link"><link="Yellowberry">Yellowberry</link></style>, 
    <style="link"><link="Chalkadonny">Chalkadonny</link></style>,  <style="link"><link="Silverfrond">Silverfrond</link></style>

    <b>Ores</b>: 
    <style="link"><link="Iron">Iron</link></style>,  <style="link"><link="Gold">Gold</link></style>, 
    <style="link"><link=Aluminum">Aluminum</link></style>,  <style="link"><link="Cobalt">Cobalt</link></style>, 
    <style="link"><link="Mithril">Mithril</link></style>

    <b>Chemicals</b>: 
    <style="link"><link="Sulfur">Sulfur</link></style>,  <style="link"><link="Morte
    Gas">Morte Gas</link></style>'
